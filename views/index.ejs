<%
  const icon = (name, size) => include('partials/icon', { name, size });
  const words = s.full_name.trim().split(/\s+/);
  const initials = (words[0][0] + (words[1] ? words[1][0] : '')).toUpperCase();
  const shortName = words.slice(0, 2).join(' ');
  const photo = s.photo_asset ? `/media/${s.photo_asset}` : '/img/profile.jpg';
  const on = (k) => s[k] === '1';
  const telHref = 'tel:' + (s.phone || '').replace(/[^\d+]/g, '');
  const waHref = s.whatsapp ? `https://wa.me/${s.whatsapp}` : null;
  const current = experiences.find((e) => e.is_current);
  const languages = (skillGroups.find((g) => g.category === 'Languages') || { items: [] }).items;
  const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: s.full_name,
    jobTitle: current ? current.title : s.headline,
    worksFor: current ? { '@type': 'Organization', name: current.company } : undefined,
    address: { '@type': 'PostalAddress', addressLocality: s.location },
    email: s.email ? `mailto:${s.email}` : undefined,
    telephone: s.phone || undefined,
    url: siteUrl,
    image: siteUrl + photo,
    sameAs: s.linkedin ? [s.linkedin] : [],
    alumniOf: education.map((e) => ({ '@type': 'EducationalOrganization', name: e.school })),
  };
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= s.seo_title || s.full_name %></title>
  <meta name="description" content="<%= s.seo_description %>">
  <link rel="canonical" href="<%= siteUrl %>/">
  <meta property="og:type" content="profile">
  <meta property="og:title" content="<%= s.seo_title || s.full_name %>">
  <meta property="og:description" content="<%= s.seo_description %>">
  <meta property="og:url" content="<%= siteUrl %>/">
  <meta property="og:image" content="<%= siteUrl + photo %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#12284A">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/css/site.css?v=3">
  <script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav" id="top">
    <div class="wrap nav__inner">
      <a class="brand" href="#top" aria-label="<%= s.full_name %>, back to top">
        <span class="brand__mark"><%= initials %></span>
        <span class="brand__name"><%= shortName %></span>
      </a>
      <nav class="nav__links" id="nav-links" aria-label="Sections">
        <a href="#about">About</a>
        <% if (on('show_experience') && experiences.length) { %><a href="#experience">Experience</a><% } %>
        <% if (on('show_skills') && skillGroups.length) { %><a href="#skills">Skills</a><% } %>
        <% if ((on('show_education') && education.length) || (on('show_certifications') && certifications.length)) { %><a href="#education">Education</a><% } %>
        <% if (on('show_contact')) { %><a href="#contact">Contact</a><% } %>
      </nav>
      <a class="btn btn--primary btn--sm nav__cta" href="/cv"><%- icon('download', 16) %> Download CV</a>
      <button class="nav__toggle" type="button" aria-controls="nav-links" aria-expanded="false" aria-label="Open menu"><%- icon('menu', 22) %></button>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__text">
          <% if (on('open_to_work') && s.availability) { %>
            <p class="status"><span class="status__dot" aria-hidden="true"></span><%= s.availability %></p>
          <% } %>
          <h1 class="hero__name"><% words.forEach((w, i) => { %><%= i ? ' ' : '' %><span class="nowrap"><%= w %></span><% }) %></h1>
          <p class="hero__headline"><%= s.headline %></p>
          <% if (s.tagline) { %><p class="hero__tagline"><%= s.tagline %></p><% } %>
          <div class="hero__actions">
            <a class="btn btn--primary" href="/cv"><%- icon('download') %> Download CV</a>
            <% if (on('show_contact')) { %><a class="btn btn--ghost" href="#contact">Get in touch <%- icon('arrow', 16) %></a><% } %>
          </div>
          <ul class="hero__meta">
            <% if (s.location) { %><li><%- icon('pin', 16) %> <%= s.location %></li><% } %>
            <% if (s.email) { %><li><a href="mailto:<%= s.email %>"><%- icon('mail', 16) %> <%= s.email %></a></li><% } %>
            <% if (s.phone) { %><li><a href="<%= telHref %>"><%- icon('phone', 16) %> <%= s.phone %></a></li><% } %>
            <% if (s.linkedin) { %><li><a href="<%= s.linkedin %>" target="_blank" rel="noopener"><%- icon('linkedin', 16) %> LinkedIn</a></li><% } %>
          </ul>
        </div>
        <figure class="hero__photo<%= s.photo_shape === 'circle' ? ' hero__photo--circle' : '' %>">
          <div class="hero__frame"><img src="<%= photo %>" alt="Portrait of <%= s.full_name %>" width="320" height="320" fetchpriority="high"></div>
          <% if (current) { %>
            <figcaption class="hero__badge">
              <span class="hero__badge-label">Currently</span>
              <strong><%= current.title %></strong>
              <span><%= current.company %></span>
            </figcaption>
          <% } %>
        </figure>
      </div>
    </section>

    <% if (on('show_achievements') && achievements.length) { %>
    <section class="stats" aria-label="Key achievements">
      <div class="wrap stats__grid">
        <% achievements.forEach((a) => { %>
          <div class="stat">
            <p class="stat__value"><%= a.value %></p>
            <p class="stat__label"><%= a.label %></p>
            <% if (a.detail) { %><p class="stat__detail"><%= a.detail %></p><% } %>
          </div>
        <% }) %>
      </div>
    </section>
    <% } %>

    <!-- About -->
    <section class="section" id="about">
      <div class="wrap about">
        <div>
          <p class="eyebrow">About</p>
          <h2 class="section__title">Professional summary</h2>
          <div class="prose">
            <% summaryParagraphs.forEach((p) => { %><p><%= p %></p><% }) %>
          </div>
        </div>
        <aside class="facts" aria-label="Quick facts">
          <h3 class="facts__title">At a glance</h3>
          <dl>
            <% if (s.location) { %><div><dt><%- icon('pin', 16) %> Based in</dt><dd><%= s.location %></dd></div><% } %>
            <% if (current) { %><div><dt><%- icon('award', 16) %> Current role</dt><dd><%= current.title %></dd></div><% } %>
            <% if (languages.length) { %><div><dt><%- icon('globe', 16) %> Languages</dt><dd><%= languages.join(' · ') %></dd></div><% } %>
            <% if (education[0]) { %><div><dt><%- icon('cap', 16) %> Education</dt><dd><%= education[0].degree %></dd></div><% } %>
          </dl>
          <a class="facts__link" href="/cv?view=1" target="_blank" rel="noopener"><%- icon('file', 16) %> View full CV (PDF)</a>
        </aside>
      </div>
    </section>

    <% if (on('show_experience') && experiences.length) { %>
    <section class="section section--tint" id="experience">
      <div class="wrap">
        <p class="eyebrow">Career</p>
        <h2 class="section__title">Professional experience</h2>
        <ol class="timeline">
          <% experiences.forEach((e) => { %>
            <li class="job<%= e.is_current ? ' job--current' : '' %>">
              <div class="job__when">
                <span><%= [e.start_label, e.end_label].filter(Boolean).join(' – ') %></span>
                <% if (e.is_current) { %><span class="pill">Current</span><% } %>
              </div>
              <div class="job__body">
                <h3 class="job__title"><%= e.title %></h3>
                <p class="job__company"><%= e.company %><% if (e.location) { %> <span class="job__loc">· <%= e.location %></span><% } %></p>
                <% if (e.bulletList.length) { %>
                  <ul class="job__points">
                    <% e.bulletList.forEach((b) => { %><li><%= b %></li><% }) %>
                  </ul>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ol>
      </div>
    </section>
    <% } %>

    <% if (on('show_skills') && skillGroups.length) { %>
    <section class="section" id="skills">
      <div class="wrap">
        <p class="eyebrow">Capabilities</p>
        <h2 class="section__title">Skills & tools</h2>
        <div class="skills">
          <% skillGroups.forEach((g, i) => { %>
            <div class="skills__group<%= i === 0 ? ' skills__group--wide' : '' %>">
              <h3><%= g.category %></h3>
              <ul class="chips">
                <% g.items.forEach((name) => { %><li><%= name %></li><% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
    <% } %>

    <% const showEdu = on('show_education') && education.length, showCert = on('show_certifications') && certifications.length; %>
    <% if (showEdu || showCert) { %>
    <section class="section section--tint" id="education">
      <div class="wrap edu<%= showEdu && showCert ? '' : ' edu--single' %>">
        <% if (showEdu) { %>
        <div>
          <p class="eyebrow">Education</p>
          <h2 class="section__title">Academic background</h2>
          <ul class="cards">
            <% education.forEach((e) => { %>
              <li class="card">
                <span class="card__icon"><%- icon('cap', 20) %></span>
                <div>
                  <h3><%= e.degree %></h3>
                  <p class="card__meta"><%= e.school %><% if (e.year_label) { %> · <%= e.year_label %><% } %></p>
                  <% if (e.details) { %><p class="card__detail"><%= e.details %></p><% } %>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>
        <% } %>
        <% if (showCert) { %>
        <div>
          <p class="eyebrow">Development</p>
          <h2 class="section__title">Courses & certifications</h2>
          <ul class="certs">
            <% certifications.forEach((c) => { %>
              <li class="cert">
                <div>
                  <h3><%= c.title %><% if (c.status) { %> <span class="pill pill--muted"><%= c.status %></span><% } %></h3>
                  <p class="card__meta"><%= [c.issuer, c.year_label].filter(Boolean).join(' · ') %></p>
                </div>
                <% if (c.asset_id) { %>
                  <a class="cert__link" href="/media/<%= c.asset_id %>" target="_blank" rel="noopener">View <%- icon('external', 14) %></a>
                <% } else if (c.url) { %>
                  <a class="cert__link" href="<%= c.url %>" target="_blank" rel="noopener">Verify <%- icon('external', 14) %></a>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <% if (on('show_contact')) { %>
    <% const showForm = on('show_contact_form'); %>
    <section class="section contact" id="contact">
      <div class="wrap contact__grid<%= showForm ? '' : ' contact__grid--single' %>">
        <div class="contact__intro">
          <% if (s.contact_eyebrow) { %><p class="eyebrow eyebrow--light"><%= s.contact_eyebrow %></p><% } %>
          <% if (s.contact_title) { %><h2 class="section__title"><%= s.contact_title %></h2><% } %>
          <% if (s.contact_lead) { %><p class="contact__lead"><%= s.contact_lead %></p><% } %>
          <ul class="contact__list">
            <% if (s.email && on('show_contact_email')) { %><li><a href="mailto:<%= s.email %>"><%- icon('mail') %><span><small>Email</small><%= s.email %></span></a></li><% } %>
            <% if (s.phone && on('show_contact_phone')) { %><li><a href="<%= telHref %>"><%- icon('phone') %><span><small>Phone</small><%= s.phone %></span></a></li><% } %>
            <% if (waHref && on('show_contact_whatsapp')) { %><li><a href="<%= waHref %>" target="_blank" rel="noopener"><%- icon('whatsapp') %><span><small>WhatsApp</small><%= s.contact_whatsapp_label || s.phone %></span></a></li><% } %>
            <% if (s.linkedin && on('show_contact_linkedin')) { %><li><a href="<%= s.linkedin %>" target="_blank" rel="noopener"><%- icon('linkedin') %><span><small>LinkedIn</small><%= s.contact_linkedin_label || 'View profile' %></span></a></li><% } %>
          </ul>
        </div>
        <% if (showForm) { %>
        <form class="form" method="post" action="/contact" id="contact-form" data-success="<%= s.contact_success %>" novalidate>
          <div class="form__row">
            <label>Your name<input name="name" autocomplete="name" required maxlength="190"></label>
            <label>Email<input name="email" type="email" autocomplete="email" required maxlength="190"></label>
          </div>
          <div class="form__row">
            <label>Company <span class="opt">(optional)</span><input name="company" autocomplete="organization" maxlength="190"></label>
            <label>Subject <span class="opt">(optional)</span><input name="subject" maxlength="255"></label>
          </div>
          <label>Message<textarea name="message" rows="5" required maxlength="5000"></textarea></label>
          <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
          <button class="btn btn--gold" type="submit"><%= s.contact_button || 'Send message' %> <%- icon('arrow', 16) %></button>
          <p class="form__status<%= sent ? ' is-ok' : '' %><%= contactError ? ' is-error' : '' %>" role="status" aria-live="polite"><%= sent ? s.contact_success : (contactError || '') %></p>
        </form>
        <% } %>
      </div>
    </section>
    <% } %>
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <% if (footerText) { %><p><%= footerText %></p><% } %>
      <% if (footerLinks.length) { %>
        <p class="footer__links">
          <% footerLinks.forEach((l) => { %><a href="<%= l.url %>"<%- l.external ? ' target="_blank" rel="noopener"' : '' %>><%= l.label %></a><% }) %>
        </p>
      <% } %>
    </div>
  </footer>

  <% if (waHref && on('show_whatsapp_button')) { %>
    <a class="wa-float" href="<%= waHref %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><%- icon('whatsapp', 26) %></a>
  <% } %>

  <script src="/js/site.js?v=2" defer></script>
</body>
</html>
