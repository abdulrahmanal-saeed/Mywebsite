# Copy these into Hostinger → Node.js app → Environment variables.
# (For local development, copy this file to .env)

NODE_ENV=production
SITE_URL=https://abdulrahmanalsaeed.com

# MySQL database (hPanel → Databases → MySQL Databases)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u807160300_cvsite
DB_USER=u807160300_cvuser
DB_PASSWORD=your-database-password

# First admin login (created once, on first start). Change the password later from the admin panel.
ADMIN_EMAIL=abdulrahmanalsaeed5@gmail.com
ADMIN_PASSWORD=choose-a-strong-password

# Long random text used to sign login sessions. Keep it secret.
SESSION_SECRET=put-a-long-random-string-here

# Email notifications for the contact form (optional but recommended)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@abdulrahmanalsaeed.com
SMTP_PASSWORD=your-mailbox-password
CONTACT_TO=abdulrahmanalsaeed5@gmail.com
